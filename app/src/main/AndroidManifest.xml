<?xml version="1.0" encoding="utf-8"?>
<!-- ===== APTUIDSH AndroidManifest =====
     本 APP 自带一整套 rootless Linux 运行环境(proroot + Ubuntu + Node + dsh),
     后端由前台服务 DshService 在 127.0.0.1:3081 上守护运行。

     【2026-09-24 形态变更】自研原生前端(对话/会话列表/设置/文件浏览/播放器/协议层)
     已整体移除,前端只保留**官方 Web UI**(WebUiActivity 内嵌 WebView)。
     原生侧只剩三件容器:首屏环境控制台(MainActivity)、官方 Web UI、环境控制台;
     协议层(包 com.aptuidsh.kui.net)与文件层(包 com.aptuidsh.kui.file)随之删除,
     因此不再需要 REQUEST_INSTALL_PACKAGES(APK 直装)与文件伺服 Provider。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络访问:连接本机 dsh 后端 http://127.0.0.1:3081 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 读取当前网络 DNS 写入 guest 的 /etc/resolv.conf -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 前台服务:挂住内置 dsh 后端进程不被系统回收 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 安装/启动期间持有 PARTIAL_WAKE_LOCK:屏幕熄灭后 CPU 仍要跑完约 200MB 镜像解压 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 13+ 通知权限(前台服务通知) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 工作区存储:guest 把 /storage/emulated/0 绑定为 /sdcard,工作区默认落在 /sdcard/APTUIDSH。
         未授予「所有文件访问」时会优雅回退到 guest 内部的 /root/workspace
         (见 ProrootEnv.defaultWorkspaceGuestPath),因此这里保留声明以便用户按需授权。 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:name=".AptuidshApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.APTUIDSH"
        android:allowBackup="true"
        android:largeHeap="true"
        android:extractNativeLibs="true"
        android:usesCleartextTraffic="true">

        <!-- 首屏:launcher —— 内置环境控制台(装/启/停/重启/更新 + 进入官方 Web UI)。
             configChanges 声明旋转/宽度变化由代码重排,避免重建 Activity 打断安装/启动流程 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 唯一前端:官方 dsh Web UI(内嵌 WebView),直连内置后端 127.0.0.1:3081 -->
        <activity
            android:name=".WebUiActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false" />

        <!-- 内置环境控制台:运行日志 / 自检 / 环境重装 -->
        <activity
            android:name=".EnvConsoleActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false" />

        <!-- 内置 dsh 后端前台服务:proroot + dsh 进程的守护者 -->
        <service
            android:name=".env.DshService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
